# Copy to .env and change values.
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./app.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# Claude API key for the AI feature (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Lets the "Simulate tap" button confirm a plan switch without an NFC reader (dev builds only show the button).
# Set to false for a real deployment.
ALLOW_SIMULATED_TAP=true
