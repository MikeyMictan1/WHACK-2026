# Copy to .env and change values.
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./app.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# Built frontend for the backend to serve (production only; the Dockerfile sets it). Leave empty
# locally, where Vite serves the frontend.
FRONTEND_DIST=

# Claude API key for the AI feature (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Built-in admin account. Recreated on every backend start if missing; can't be registered or deleted.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-change-me

# Lets "Simulate tap" stand in for a real NFC card tap (shop purchases and plan switches).
# Set to false for a real deployment.
ALLOW_SIMULATED_TAP=true

# Laptop bridge: lend this laptop's NFC reader and LED board to the deployed site (npm run bridge).
# BRIDGE_TOKEN must match the site's BRIDGE_TOKEN variable. On the site, an empty token disables it.
BRIDGE_URL=
BRIDGE_TOKEN=

# LED "Weather" skin location (default London)
WEATHER_LAT=51.5074
WEATHER_LON=-0.1278
