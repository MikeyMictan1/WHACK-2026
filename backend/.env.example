# Copy to .env and change values.
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./app.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# Claude API key for the AI feature (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Allow paying in the shop without tapping a real NFC card ("Simulate tap")
ALLOW_SIMULATED_TAP=true

# LED "Weather" skin location (default London)
WEATHER_LAT=51.5074
WEATHER_LON=-0.1278
